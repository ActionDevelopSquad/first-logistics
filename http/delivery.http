##########################################################
# 배송 서비스 API 통합 테스트
# 사전 조건: delivery-setup.http 실행 완료
# 토큰: masterToken, hubManagerToken, hubDeliveryManagerToken
##########################################################

### ========== 배송 담당자 API ==========

### 배송 담당자 목록 조회 (마스터)
GET {{gatewayUrl}}/api/v1/delivery-managers?size=10
Authorization: Bearer {{masterToken}}

### 배송 담당자 목록 조회 - managerType 필터
GET {{gatewayUrl}}/api/v1/delivery-managers?managerType=HUB_DELIVERY&size=10
Authorization: Bearer {{masterToken}}

### 배송 담당자 목록 조회 - hubId 필터
GET {{gatewayUrl}}/api/v1/delivery-managers?hubId={{seoulHubId}}&size=10
Authorization: Bearer {{masterToken}}

### 배송 담당자 목록 조회 (허브 관리자 - 자기 허브만)
GET {{gatewayUrl}}/api/v1/delivery-managers?size=10
Authorization: Bearer {{hubManagerToken}}

### 배송 담당자 목록 조회 (배송 담당자 - 본인만)
GET {{gatewayUrl}}/api/v1/delivery-managers?size=10
Authorization: Bearer {{hubDeliveryManagerToken}}

### 배송 담당자 userId로 조회 (본인 정보)
GET {{gatewayUrl}}/api/v1/delivery-managers/users/{{hubDeliveryManagerUserId}}
Authorization: Bearer {{hubDeliveryManagerToken}}

> {%
    client.global.set("hubDeliveryManagerId", response.body.data.managerId);
%}

### 배송 담당자 userId로 조회 (업체 배송담당자)
GET {{gatewayUrl}}/api/v1/delivery-managers/users/{{companyDeliveryManagerUserId}}
Authorization: Bearer {{masterToken}}

> {%
    client.global.set("companyDeliveryManagerId", response.body.data.managerId);
%}

### 배송 담당자 상세 조회
GET {{gatewayUrl}}/api/v1/delivery-managers/{{hubDeliveryManagerId}}
Authorization: Bearer {{masterToken}}

### 배송 담당자 수동 생성 (마스터)
POST {{gatewayUrl}}/api/v1/delivery-managers
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "userId": "11111111-1111-1111-1111-111111111111",
  "hubId": "{{seoulHubId}}",
  "managerType": "HUB_DELIVERY"
}

> {%
    client.global.set("manualDeliveryManagerId", response.body.data.deliveryManagerId);
%}

### 배송 담당자 수정 (허브/타입 변경)
PATCH {{gatewayUrl}}/api/v1/delivery-managers/{{manualDeliveryManagerId}}
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "hubId": "{{busanHubId}}",
  "managerType": "COMPANY_DELIVERY"
}

### 배송 담당자 삭제
DELETE {{gatewayUrl}}/api/v1/delivery-managers/{{manualDeliveryManagerId}}
Authorization: Bearer {{masterToken}}

### ========== 배송 API ==========

### 배송 목록 조회 (마스터 - 전체)
GET {{gatewayUrl}}/api/v1/deliveries?size=10
Authorization: Bearer {{masterToken}}

> {%
    var deliveries = response.body.data.deliveries;
    if (deliveries && deliveries.length > 0) {
        client.global.set("deliveryId", deliveries[0].deliveryId);
    }
%}

### 배송 목록 조회 - 상태 필터
GET {{gatewayUrl}}/api/v1/deliveries?status=CREATED&size=10
Authorization: Bearer {{masterToken}}

### 배송 목록 조회 - 출발 허브 필터
GET {{gatewayUrl}}/api/v1/deliveries?sourceHubId={{seoulHubId}}&size=10
Authorization: Bearer {{masterToken}}

### 배송 목록 조회 - 날짜 범위
GET {{gatewayUrl}}/api/v1/deliveries?startDate=2026-04-01T00:00:00&endDate=2026-04-30T23:59:59&size=10
Authorization: Bearer {{masterToken}}

### 배송 목록 조회 (허브 관리자)
GET {{gatewayUrl}}/api/v1/deliveries?size=10
Authorization: Bearer {{hubManagerToken}}

### 배송 목록 조회 (배송 담당자)
GET {{gatewayUrl}}/api/v1/deliveries?size=10
Authorization: Bearer {{hubDeliveryManagerToken}}

### 배송 상세 조회
GET {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}
Authorization: Bearer {{masterToken}}

### 배송 수정 (수령인 변경)
PATCH {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "receiverId": "{{receiverManagerUserId}}",
  "receiverSlackId": "U_COMPMGR02_UPDATED"
}

### 배송 수동 생성 (마스터 전용)
POST {{gatewayUrl}}/api/v1/deliveries
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "orderId": "22222222-2222-2222-2222-222222222222",
  "orderedAt": "2026-04-06T10:00:00",
  "orderDueDate": "2026-04-10T18:00:00",
  "orderRequestNote": "수동 생성 테스트",
  "supplier": {
    "companyId": "{{supplierCompanyId}}",
    "managerId": "{{companyManagerUserId}}"
  },
  "receiver": {
    "companyId": "{{receiverCompanyId}}",
    "managerId": "{{receiverManagerUserId}}",
    "roadAddress": "부산 해운대구 해운대로 456",
    "detailAddress": "1층"
  },
  "orderItems": [
    {
      "productId": "{{productId}}",
      "productName": "마른오징어 가공품",
      "quantity": 10,
      "price": 15000
    }
  ]
}

> {%
    client.global.set("manualDeliveryId", response.body.data.deliveryId);
%}

### ========== 배송 상태 변경 플로우 ==========
# CREATED → FOR_HUB_MOVING → HUB_ARRIVED → HUB_WAITING → FOR_COMPANY_MOVING → COMPLETED

### 배송 시작 (CREATED → FOR_HUB_MOVING)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/start
Authorization: Bearer {{masterToken}}

### 허브 도착 (FOR_HUB_MOVING → HUB_ARRIVED)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/arrive-hub
Authorization: Bearer {{masterToken}}

### 허브 입고 (HUB_ARRIVED → HUB_WAITING)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/receive-hub
Authorization: Bearer {{masterToken}}

### 업체 배송 시작 (HUB_WAITING(마지막 허브) → FOR_COMPANY_MOVING)
# 마지막 허브가 아니면 start로 다시 FOR_HUB_MOVING
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/start-company
Authorization: Bearer {{masterToken}}

### 배송 완료 (FOR_COMPANY_MOVING → COMPLETED)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/complete
Authorization: Bearer {{masterToken}}

### ========== 배송 취소/삭제 ==========

### 배송 취소 (CREATED 상태에서만 가능, manualDeliveryId 사용)
POST {{gatewayUrl}}/api/v1/deliveries/{{manualDeliveryId}}/cancel
Authorization: Bearer {{masterToken}}

### 배송 삭제 (soft delete)
DELETE {{gatewayUrl}}/api/v1/deliveries/{{manualDeliveryId}}
Authorization: Bearer {{masterToken}}

### ========== 에러 케이스 ==========

### 존재하지 않는 배송 조회 (404)
GET {{gatewayUrl}}/api/v1/deliveries/99999999-9999-9999-9999-999999999999
Authorization: Bearer {{masterToken}}

### 배송 담당자 존재하지 않는 ID 조회 (404)
GET {{gatewayUrl}}/api/v1/delivery-managers/99999999-9999-9999-9999-999999999999
Authorization: Bearer {{masterToken}}

### 커서 페이지네이션 - 다음 페이지
# 첫 페이지 조회 후 nextCursorId, nextCursorCreatedAt 값을 사용
# GET {{gatewayUrl}}/api/v1/deliveries?cursorId={{nextCursorId}}&cursorCreatedAt={{nextCursorCreatedAt}}&size=10
# Authorization: Bearer {{masterToken}}
