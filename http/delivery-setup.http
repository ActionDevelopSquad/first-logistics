  "email": "compdm01@test.com",
  "slackId": "U_COMPDM01",
  "userRole": "DELIVERY_MANAGER",
  "organizationId": "{{busanHubId}}"
}

> {%
    client.global.set("companyDeliveryManagerUserId", response.body.data.userId);
%}

### ========== 21. 허브 배송담당자 승인 → Kafka로 배송담당자 자동 생성 ==========
PATCH {{gatewayUrl}}/api/v1/users/{{hubDeliveryManagerUserId}}/status
Content-Type: application/json
Authorization: Bearer {{masterToken}}
X-User-Id: {{masterUserId}}

{
  "status": "APPROVED"
}

### ========== 22. 업체 배송담당자 승인 → Kafka로 배송담당자 자동 생성 ==========
PATCH {{gatewayUrl}}/api/v1/users/{{companyDeliveryManagerUserId}}/status
Content-Type: application/json
Authorization: Bearer {{masterToken}}
X-User-Id: {{masterUserId}}

{
  "status": "APPROVED"
}

### ========== 23. 배송담당자 로그인 (허브) ==========
POST {{gatewayUrl}}/api/v1/users/login
Content-Type: application/json

{
  "username": "{{hubDeliveryManagerUsername}}",
  "password": "{{hubDeliveryManagerPassword}}"
}

> {%
    client.global.set("hubDeliveryManagerToken", response.body.data.accessToken);
%}

### ========== 24. 배송담당자 로그인 (업체) ==========
POST {{gatewayUrl}}/api/v1/users/login
Content-Type: application/json

{
  "username": "{{companyDeliveryManagerUsername}}",
  "password": "{{companyDeliveryManagerPassword}}"
}

> {%
    client.global.set("companyDeliveryManagerToken", response.body.data.accessToken);
%}

### ========== 25. 상품 생성 (공급업체 소속) ==========
POST {{gatewayUrl}}/api/v1/products
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "companyId": "{{supplierCompanyId}}",
  "name": "마른오징어 가공품",
  "price": 15000,
  "stock": 100
}

> {%
    client.global.set("productId", response.body.data.productId);
%}

### ========== 26. 주문 생성 → Kafka(order.accepted) → 배송 자동 생성 ==========
POST {{gatewayUrl}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "supplierCompanyId": "{{supplierCompanyId}}",
  "supplierManagerId": "{{companyManagerUserId}}",
  "receiverCompanyId": "{{receiverCompanyId}}",
  "receiverManagerId": "{{receiverManagerUserId}}",
  "roadAddress": "부산 해운대구 해운대로 456",
  "detailAddress": "1층",
  "dueDate": "2026-04-10T18:00:00",
  "requestMemo": "통합테스트 주문",
  "items": [
    {
      "productId": "{{productId}}",
      "productName": "마른오징어 가공품",
      "unitPrice": 15000,
      "quantity": 50
    }
  ]
}

> {%
    client.global.set("orderId", response.body.data.orderId);
%}

### ========== 27. 주문 승인 → Kafka(order.accepted) → 배송 자동 생성 ==========
PATCH {{gatewayUrl}}/api/v1/orders/{{orderId}}/acceptance
Content-Type: application/json
Authorization: Bearer {{masterToken}}

### ========== 셋업 완료 ==========
# 이제 delivery.http에서 배송 서비스 API를 테스트할 수 있습니다.
# Kafka 이벤트 처리에 약간의 시간이 소요될 수 있습니다.
# 배송 목록 조회로 배송이 자동 생성되었는지 확인하세요.
