##########################################################
# 배송 서비스 통합 테스트 - 사전 데이터 셋업
# 실행 순서대로 진행해주세요.
##########################################################

### ========== 1. 마스터 회원가입 ==========
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "{{masterUsername}}",
  "password": {
    "password": "{{masterPassword}}",
    "confirmPassword": "{{masterPassword}}"
  },
  "firstName": "마스터",
  "lastName": "관리자",
  "phone": "010-1111-0001",
  "email": "master01@test.com",
  "slackId": "U_MASTER01",
  "userRole": "MASTER",
  "organizationId": "00000000-0000-0000-0000-000000000000"
}

> {%
    client.global.set("masterUserId", response.body.data.userId);
%}

### ========== 2. 마스터 승인 (자가 승인 또는 시스템 승인) ==========
PATCH {{gatewayUrl}}/api/v1/users/{{masterUserId}}/status
Content-Type: application/json
X-User-Id: {{masterUserId}}

{
  "status": "APPROVED"
}

### ========== 3. 마스터 로그인 ==========
POST {{gatewayUrl}}/api/v1/users/login
Content-Type: application/json

{
  "username": "{{masterUsername}}",
  "password": "{{masterPassword}}"
}

> {%
    client.global.set("masterToken", response.body.data.accessToken);
%}

### ========== 4. 허브 생성 - 서울 ==========
POST {{gatewayUrl}}/api/v1/hubs
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "name": "서울특별시 센터",
  "roadAddress": "서울특별시 송파구 송파대로 55",
  "latitude": 37.5145,
  "longitude": 127.1050,
  "type": "CENTRAL"
}

> {%
    client.global.set("seoulHubId", response.body.data.hubId);
%}

### ========== 5. 허브 생성 - 경기 북부 ==========
POST {{gatewayUrl}}/api/v1/hubs
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "name": "경기 북부 센터",
  "roadAddress": "경기도 고양시 덕양구 권율대로 570",
  "latitude": 37.6584,
  "longitude": 126.8320,
  "type": "REGIONAL"
}

> {%
    client.global.set("gyeonggiHubId", response.body.data.hubId);
%}

### ========== 6. 허브 생성 - 부산 ==========
POST {{gatewayUrl}}/api/v1/hubs
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "name": "부산광역시 센터",
  "roadAddress": "부산 동구 중앙대로 206",
  "latitude": 35.1146,
  "longitude": 129.0405,
  "type": "REGIONAL"
}

> {%
    client.global.set("busanHubId", response.body.data.hubId);
%}

### ========== 7. 허브 간 이동정보 - 서울 → 경기 북부 ==========
POST {{gatewayUrl}}/api/v1/hub-connections
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "sourceHubId": "{{seoulHubId}}",
  "destinationHubId": "{{gyeonggiHubId}}",
  "minutes": 60,
  "meters": 35000
}

### ========== 8. 허브 간 이동정보 - 경기 북부 → 부산 ==========
POST {{gatewayUrl}}/api/v1/hub-connections
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "sourceHubId": "{{gyeonggiHubId}}",
  "destinationHubId": "{{busanHubId}}",
  "minutes": 300,
  "meters": 400000
}

### ========== 9. 허브 간 이동정보 - 서울 → 부산 (직통) ==========
POST {{gatewayUrl}}/api/v1/hub-connections
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "sourceHubId": "{{seoulHubId}}",
  "destinationHubId": "{{busanHubId}}",
  "minutes": 330,
  "meters": 450000
}

### ========== 10. 허브 관리자 회원가입 (서울 허브) ==========
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "{{hubManagerUsername}}",
  "password": {
    "password": "{{hubManagerPassword}}",
    "confirmPassword": "{{hubManagerPassword}}"
  },
  "firstName": "허브",
  "lastName": "관리자",
  "phone": "010-2222-0001",
  "email": "hubmgr01@test.com",
  "slackId": "U_HUBMGR01",
  "userRole": "HUB_MANAGER",
  "organizationId": "{{seoulHubId}}"
}

> {%
    client.global.set("hubManagerUserId", response.body.data.userId);
%}

### ========== 11. 허브 관리자 승인 ==========
PATCH {{gatewayUrl}}/api/v1/users/{{hubManagerUserId}}/status
Content-Type: application/json
Authorization: Bearer {{masterToken}}
X-User-Id: {{masterUserId}}

{
  "status": "APPROVED"
}

### ========== 12. 허브 관리자 로그인 ==========
POST {{gatewayUrl}}/api/v1/users/login
Content-Type: application/json

{
  "username": "{{hubManagerUsername}}",
  "password": "{{hubManagerPassword}}"
}

> {%
    client.global.set("hubManagerToken", response.body.data.accessToken);
%}

### ========== 13. 업체 담당자 회원가입 (공급업체용) ==========
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "{{companyManagerUsername}}",
  "password": {
    "password": "{{companyManagerPassword}}",
    "confirmPassword": "{{companyManagerPassword}}"
  },
  "firstName": "업체",
  "lastName": "담당자",
  "phone": "010-3333-0001",
  "email": "compmgr01@test.com",
  "slackId": "U_COMPMGR01",
  "userRole": "COMPANY_MANAGER",
  "organizationId": "{{seoulHubId}}"
}

> {%
    client.global.set("companyManagerUserId", response.body.data.userId);
%}

### ========== 14. 업체 담당자 회원가입 (수령업체용) ==========
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "compmgr02",
  "password": {
    "password": "Test1234!",
    "confirmPassword": "Test1234!"
  },
  "firstName": "수령",
  "lastName": "담당자",
  "phone": "010-3333-0002",
  "email": "compmgr02@test.com",
  "slackId": "U_COMPMGR02",
  "userRole": "COMPANY_MANAGER",
  "organizationId": "{{busanHubId}}"
}

> {%
    client.global.set("receiverManagerUserId", response.body.data.userId);
%}

### ========== 15. 업체 담당자 승인 (공급업체) ==========
PATCH {{gatewayUrl}}/api/v1/users/{{companyManagerUserId}}/status
Content-Type: application/json
Authorization: Bearer {{masterToken}}
X-User-Id: {{masterUserId}}

{
  "status": "APPROVED"
}

### ========== 16. 업체 담당자 승인 (수령업체) ==========
PATCH {{gatewayUrl}}/api/v1/users/{{receiverManagerUserId}}/status
Content-Type: application/json
Authorization: Bearer {{masterToken}}
X-User-Id: {{masterUserId}}

{
  "status": "APPROVED"
}

### ========== 17. 공급업체 생성 (서울 허브 소속) ==========
POST {{gatewayUrl}}/api/v1/companies
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "managerId": "{{companyManagerUserId}}",
  "name": "건조 식품 가공 업체",
  "type": "SUPPLIER",
  "roadAddress": "서울특별시 강남구 테헤란로 123",
  "detailAddress": "5층",
  "latitude": 37.4979,
  "longitude": 127.0276
}

> {%
    client.global.set("supplierCompanyId", response.body.data.companyId);
%}

### ========== 18. 수령업체 생성 (부산 허브 소속) ==========
POST {{gatewayUrl}}/api/v1/companies
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "managerId": "{{receiverManagerUserId}}",
  "name": "수산물 도매 업체",
  "type": "RECEIVER",
  "roadAddress": "부산 해운대구 해운대로 456",
  "detailAddress": "1층",
  "latitude": 35.1631,
  "longitude": 129.1636
}

> {%
    client.global.set("receiverCompanyId", response.body.data.companyId);
%}

### ========== 19. 허브 배송담당자 회원가입 ==========
# 승인 시 Kafka(user.status.changed) → delivery-service에서 자동 생성
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "{{hubDeliveryManagerUsername}}",
  "password": {
    "password": "{{hubDeliveryManagerPassword}}",
    "confirmPassword": "{{hubDeliveryManagerPassword}}"
  },
  "firstName": "허브배송",
  "lastName": "담당자",
  "phone": "010-4444-0001",
  "email": "hubdm01@test.com",
  "slackId": "U_HUBDM01",
  "userRole": "DELIVERY_MANAGER",
  "organizationId": "{{seoulHubId}}"
}

> {%
    client.global.set("hubDeliveryManagerUserId", response.body.data.userId);
%}

