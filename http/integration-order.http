# ================================================================
# 통합 테스트 - 주문/배송 사이클
# ================================================================
# [최초 실행 시] integration-setup.http를 먼저 실행하세요.
# [반복 실행 시] 이 파일만 실행하면 됩니다 (배송담당자 매번 새로 생성).
# 변수(masterToken, supplierCompanyId 등)는 global로 공유됨
# ================================================================

### Step 1. 마스터 로그인 (토큰 갱신)
POST {{gatewayUrl}}/api/v1/users/login
Content-Type: application/json

{ "username": "{{masterUsername}}", "password": "{{masterPassword}}" }

> {%
  if (response.status !== 200) { client.log("FAIL: 마스터 로그인 실패"); client.assert(false); }
  client.global.set("masterToken", response.body.data.accessToken);
  var suffix = Math.floor(Math.random() * 100000);
  client.global.set("dmSuffix", suffix);
  client.log("[Step 1] masterToken 갱신 완료 / dmSuffix = " + suffix);
%}

# ================================================================
# 배송담당자 생성 (매 실행마다 새로 생성)
# ================================================================

### Step 2. 허브 배송담당자 회원가입 (서울)
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "hdm{{dmSuffix}}",
  "password": { "password": "Test1234!", "confirmPassword": "Test1234!" },
  "firstName": "서울허브", "lastName": "배송{{dmSuffix}}",
  "phone": "010-{{dmSuffix}}-0001", "email": "hdm{{dmSuffix}}@test.com", "slackId": "U0ADEL196UT",
  "userRole": "DELIVERY_MANAGER", "managerType": "HUB_DELIVERY", "hubId": "{{seoulHubId}}"
}

> {%
  if (response.status !== 201) { client.log("FAIL: 서울 허브 배송담당자 회원가입 실패"); client.assert(false); }
  client.global.set("hubDeliveryManagerUserId", response.body.data.userId);
  client.log("[Step 2] 서울 허브 배송담당자 생성 완료");
%}

### Step 3. 허브 배송담당자 회원가입 (대구)
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "ddm{{dmSuffix}}",
  "password": { "password": "Test1234!", "confirmPassword": "Test1234!" },
  "firstName": "대구허브", "lastName": "배송{{dmSuffix}}",
  "phone": "010-{{dmSuffix}}-0002", "email": "ddm{{dmSuffix}}@test.com", "slackId": "U0ADEL196UT",
  "userRole": "DELIVERY_MANAGER", "managerType": "HUB_DELIVERY", "hubId": "{{daeguHubId}}"
}

> {%
  if (response.status !== 201) { client.log("FAIL: 대구 허브 배송담당자 회원가입 실패"); client.assert(false); }
  client.global.set("daeguHubDeliveryManagerUserId", response.body.data.userId);
  client.log("[Step 3] 대구 허브 배송담당자 생성 완료");
%}

### Step 4. 업체 배송담당자 회원가입 (부산)
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "cdm{{dmSuffix}}",
  "password": { "password": "Test1234!", "confirmPassword": "Test1234!" },
  "firstName": "업체", "lastName": "배송{{dmSuffix}}",
  "phone": "010-{{dmSuffix}}-0003", "email": "cdm{{dmSuffix}}@test.com", "slackId": "U0ADEL196UT",
  "userRole": "DELIVERY_MANAGER", "managerType": "COMPANY_DELIVERY", "hubId": "{{busanHubId}}"
}

> {%
  if (response.status !== 201) { client.log("FAIL: 업체 배송담당자 회원가입 실패"); client.assert(false); }
  client.global.set("companyDeliveryManagerUserId", response.body.data.userId);
  client.log("[Step 4] 업체 배송담당자 생성 완료");
%}

### Step 5. 허브 배송담당자 승인 (서울)
PATCH {{gatewayUrl}}/api/v1/users/{{hubDeliveryManagerUserId}}/status
Content-Type: application/json
Authorization: Bearer {{masterToken}}
X-User-Id: {{masterUserId}}

{ "status": "APPROVED" }

> {%
  if (response.status !== 200) { client.log("FAIL: 서울 배송담당자 승인 실패"); client.assert(false); }
  client.log("[Step 5] 서울 허브 배송담당자 승인 완료");
%}

### Step 6. 허브 배송담당자 승인 (대구)
PATCH {{gatewayUrl}}/api/v1/users/{{daeguHubDeliveryManagerUserId}}/status
Content-Type: application/json
Authorization: Bearer {{masterToken}}
X-User-Id: {{masterUserId}}

{ "status": "APPROVED" }

> {%
  if (response.status !== 200) { client.log("FAIL: 대구 배송담당자 승인 실패"); client.assert(false); }
  client.log("[Step 6] 대구 허브 배송담당자 승인 완료");
%}

### Step 7. 업체 배송담당자 승인 (부산)
PATCH {{gatewayUrl}}/api/v1/users/{{companyDeliveryManagerUserId}}/status
Content-Type: application/json
Authorization: Bearer {{masterToken}}
X-User-Id: {{masterUserId}}

{ "status": "APPROVED" }

> {%
  function wait(sec) { let s = Date.now(); while (Date.now() - s < sec * 1000) {} }
  if (response.status !== 200) { client.log("FAIL: 업체 배송담당자 승인 실패"); wait(15); }
  else { client.log("[Step 7] 업체 배송담당자 승인 완료"); wait(1.5); }
%}

### Step 8. 배송담당자 목록 조회 (검증)
GET {{gatewayUrl}}/api/v1/delivery-managers
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 배송담당자 목록 조회 실패"); client.assert(false); }
  client.log("[Step 8] 배송담당자 수 = " + response.body.data.managers.length);
%}

# ================================================================
# 주문 생성 → 재고 예약
# ================================================================

### Step 9. 주문 생성 → Kafka → 재고 예약
POST {{gatewayUrl}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "supplierCompanyId": "{{supplierCompanyId}}",
  "supplierManagerId": "{{companyManagerUserId}}",
  "receiverCompanyId": "{{receiverCompanyId}}",
  "receiverManagerId": "{{receiverManagerUserId}}",
  "roadAddress": "부산 해운대구 해운대로 456",
  "detailAddress": "1층",
  "dueDate": "2026-04-15T18:00:00",
  "requestMemo": "통합테스트 주문",
  "items": [
    {
      "productId": "{{productId}}",
      "productName": "마른오징어 가공품",
      "unitPrice": 15000,
      "quantity": 10
    }
  ]
}

> {%
  function wait(sec) { let s = Date.now(); while (Date.now() - s < sec * 1000) {} }
  if (response.status !== 201) { client.log("FAIL: 주문 생성 실패"); wait(15); }
  else {
    client.global.set("orderId", response.body.data.orderId);
    client.log("[Step 9] orderId = " + client.global.get("orderId"));
    wait(1.5);
  }
%}

### Step 10. 주문 상세 조회 (재고 예약 상태 검증)
GET {{gatewayUrl}}/api/v1/orders/{{orderId}}
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 주문 상세 조회 실패"); client.assert(false); }
  client.log("[Step 10] 주문 상태 = " + response.body.data.status);
%}

### Step 11. 재고 조회 (예약 반영 확인)
GET {{gatewayUrl}}/api/v1/products/{{productId}}/stock
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 재고 조회 실패"); client.assert(false); }
  client.log("[Step 11] 가용 재고 = " + response.body.data.available + " / 예약 = " + response.body.data.reserved);
%}

# ================================================================
# 주문 승인 → 배송 생성 + 재고 차감
# ================================================================

### Step 12. 주문 승인 → Kafka → 배송 자동 생성 + 재고 차감
PATCH {{gatewayUrl}}/api/v1/orders/{{orderId}}/acceptance
Content-Type: application/json
Authorization: Bearer {{masterToken}}

> {%
  function wait(sec) { let s = Date.now(); while (Date.now() - s < sec * 1000) {} }
  if (response.status !== 200) { client.log("FAIL: 주문 승인 실패"); wait(15); }
  else { client.log("[Step 12] 주문 승인 완료"); wait(1.5); }
%}

### Step 13. 배송 목록 조회 (배송 생성 확인)
GET {{gatewayUrl}}/api/v1/deliveries?orderId={{orderId}}
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 배송 목록 조회 실패"); client.assert(false); }
  var deliveries = response.body.data.deliveries;
  if (deliveries.length === 0) { client.log("FAIL: 배송 미생성"); client.assert(false); }
  client.global.set("deliveryId", deliveries[0].deliveryId);
  client.log("[Step 13] deliveryId = " + client.global.get("deliveryId") + " / 상태 = " + deliveries[0].status);
%}

### Step 14. 배송 상세 조회
GET {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 배송 상세 조회 실패"); client.assert(false); }
  client.log("[Step 14] 배송 상태 = " + response.body.data.status + " / 경로 수 = " + response.body.data.routes.length);
%}

### Step 15. 재고 조회 (차감 확인)
GET {{gatewayUrl}}/api/v1/products/{{productId}}/stock
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 재고 조회 실패"); client.assert(false); }
  client.log("[Step 15] 가용 재고 = " + response.body.data.available + " / 예약 = " + response.body.data.reserved);
%}

### Step 16. 주문 상세 조회 (배송 생성 완료 후)
GET {{gatewayUrl}}/api/v1/orders/{{orderId}}
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 주문 상세 조회 실패"); client.assert(false); }
  client.log("[Step 16] 주문 상태 = " + response.body.data.status + " / deliveryId = " + response.body.data.deliveryId);
%}

### Step 17. 알림 조회 (배송 생성 알림)
GET {{gatewayUrl}}/api/v1/notifications?page=0&size=10
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 알림 조회 실패"); client.assert(false); }
  client.log("[Step 17] 알림 조회 완료");
%}

# ================================================================
# 배송 진행 - 1구간 (서울 → 대구)
# ================================================================

### Step 18. 허브 배송 시작 1구간 (CREATED → FOR_HUB_MOVING)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/start
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 1구간 배송 시작 실패"); client.assert(false); }
  client.log("[Step 18] 1구간 허브 배송 시작 (서울→대구)");
%}

### Step 19. 배송 상세 조회 (이동 중 검증)
GET {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 배송 상세 조회 실패"); client.assert(false); }
  client.log("[Step 19] 배송 상태 = " + response.body.data.status);
%}

### Step 20. 허브 도착 1구간 (FOR_HUB_MOVING → HUB_ARRIVED)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/arrive-hub
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 1구간 허브 도착 실패"); client.assert(false); }
  client.log("[Step 20] 1구간 허브 도착 (대구)");
%}

### Step 21. 허브 입고 1구간 (HUB_ARRIVED → HUB_WAITING)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/receive-hub
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 1구간 허브 입고 실패"); client.assert(false); }
  client.log("[Step 21] 1구간 허브 입고 (대구)");
%}

# ================================================================
# 배송 진행 - 2구간 (대구 → 부산)
# ================================================================

### Step 22. 허브 배송 시작 2구간 (HUB_WAITING → FOR_HUB_MOVING)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/start
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 2구간 배송 시작 실패"); client.assert(false); }
  client.log("[Step 22] 2구간 허브 배송 시작 (대구→부산)");
%}

### Step 23. 허브 도착 2구간 (FOR_HUB_MOVING → HUB_ARRIVED)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/arrive-hub
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 2구간 허브 도착 실패"); client.assert(false); }
  client.log("[Step 23] 2구간 허브 도착 (부산)");
%}

### Step 24. 허브 입고 2구간 (HUB_ARRIVED → HUB_WAITING)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/receive-hub
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 2구간 허브 입고 실패"); client.assert(false); }
  client.log("[Step 24] 2구간 허브 입고 (부산)");
%}

### Step 25. 배송 상세 조회 (허브 이동 완료 검증)
GET {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 배송 상세 조회 실패"); client.assert(false); }
  client.log("[Step 25] 배송 상태 = " + response.body.data.status);
%}

# ================================================================
# 배송 진행 - 업체 배송 (부산 → 수령업체)
# ================================================================

### Step 26. 업체 배송 시작 (HUB_WAITING → FOR_COMPANY_MOVING)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/start-company
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 업체 배송 시작 실패"); client.assert(false); }
  client.log("[Step 26] 업체 배송 시작 (부산→수령업체)");
%}

### Step 27. 배송 상세 조회 (업체 배송 중 검증)
GET {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 배송 상세 조회 실패"); client.assert(false); }
  client.log("[Step 27] 배송 상태 = " + response.body.data.status);
%}

### Step 28. 배송 완료 (FOR_COMPANY_MOVING → COMPLETED)
POST {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}/complete
Authorization: Bearer {{masterToken}}

> {%
  function wait(sec) { let s = Date.now(); while (Date.now() - s < sec * 1000) {} }
  if (response.status !== 200) { client.log("FAIL: 배송 완료 실패"); wait(15); }
  else { client.log("[Step 28] 배송 완료 (COMPLETED)"); wait(1.5); }
%}

### Step 29. 배송 상세 조회 (최종 상태 검증)
GET {{gatewayUrl}}/api/v1/deliveries/{{deliveryId}}
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 배송 상세 조회 실패"); client.assert(false); }
  var status = response.body.data.status;
  if (status !== "COMPLETED") { client.log("FAIL: 배송 상태가 COMPLETED가 아님: " + status); client.assert(false); }
  client.log("[Step 29] 배송 최종 상태 = " + status);
%}

### Step 30. 알림 조회 (배송 완료 알림)
GET {{gatewayUrl}}/api/v1/notifications?page=0&size=10
Authorization: Bearer {{masterToken}}

> {%
  if (response.status !== 200) { client.log("FAIL: 알림 조회 실패"); client.assert(false); }
  client.log("[Step 30] 배송 완료 후 알림 조회 완료");
%}

