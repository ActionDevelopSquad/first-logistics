Content-Type: application/json

{
  "username": "{{hubDeliveryManagerUsername}}",
  "password": {
    "password": "{{hubDeliveryManagerPassword}}",
    "confirmPassword": "{{hubDeliveryManagerPassword}}"
  },
  "firstName": "허브배송",
  "lastName": "담당자",
  "phone": "010-4444-9001",
  "email": "hubdm-int@test.com",
  "slackId": "U_HUBDM_INT",
  "userRole": "DELIVERY_MANAGER",
  "hubId": "{{seoulHubId}}"
}

> {%
  if (response.status !== 201) { client.log("FAIL: 허브 배송담당자 회원가입 실패"); client.assert(false); }
  client.global.set("hubDeliveryManagerUserId", response.body.data.userId);
  client.log("[Step 24] hubDeliveryManagerUserId = " + client.global.get("hubDeliveryManagerUserId"));
%}

### Step 25. 업체 배송담당자 회원가입
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "{{companyDeliveryManagerUsername}}",
  "password": {
    "password": "{{companyDeliveryManagerPassword}}",
    "confirmPassword": "{{companyDeliveryManagerPassword}}"
  },
  "firstName": "업체배송",
