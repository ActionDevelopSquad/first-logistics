# ================================================================
# 일등 물류 통합 테스트 - 전체 성공 사이클
# ================================================================
# 기본 URL : {{gatewayUrl}} (API Gateway)
# 실행 방법: Step 순서대로 클릭 (IntelliJ HTTP Client)
# 환경 선택: dev — 우측 드롭다운에서 선택
#
# ----------------------------------------------------------------
# 전체 흐름 요약
# ----------------------------------------------------------------
#
# [SECTION 1] 마스터 관리자 설정
#   Step  1. 마스터 회원가입 (MASTER는 자동 승인)
#   Step  2. 마스터 로그인
#
# [SECTION 2] 허브 인프라 구축
#   Step  4~9. 허브 생성 (서울, 경기 북부, 경기 남부, 부산, 대구, 대전)
#   Step 10~18. 허브 간 이동정보 생성
#
# [SECTION 3] 사용자 + 업체 등록
#   Step 19. 허브 관리자 회원가입 (서울 허브)
#   Step 20. 허브 관리자 승인 (Kafka → 허브 관리자 자동 생성)
#   Step 21. 허브 관리자 로그인
#   Step 22. 업체 담당자 회원가입 (공급)
#   Step 23. 공급업체 생성 (서울 허브)
#   Step 24. 업체 담당자 회원가입 (수령)
#   Step 25. 수령업체 생성 (부산 허브)
#
# [SECTION 4] 업체 검증 + 상품 등록
#   Step 26. 업체 목록 조회 (검증)
#   Step 27. 상품 생성 (공급업체)
#   Step 28. 상품 조회 (검증)
#   Step 29. 재고 조회 (검증)
#
# [SECTION 5] 배송 담당자 등록 (Kafka 자동 생성)
#   Step 30. 허브 배송담당자 회원가입 (서울)
#   Step 31. 허브 배송담당자 회원가입 (대구)
#   Step 32. 업체 배송담당자 회원가입 (부산)
#   Step 33. 허브 배송담당자 승인 (서울) -> Kafka -> 배송담당자 자동 생성
#   Step 34. 허브 배송담당자 승인 (대구) -> Kafka -> 배송담당자 자동 생성
#   Step 35. 업체 배송담당자 승인 -> Kafka -> 배송담당자 자동 생성
#   Step 36. 배송담당자 목록 조회 (검증)
#
# [SECTION 6] 주문 생성 -> 재고 예약 -> 주문 완료
#   Step 37. 주문 생성 -> Kafka -> 재고 예약 요청
#   Step 38. 주문 상세 조회 (재고 예약 완료 후 상태 검증)
#   Step 39. 재고 조회 (예약 반영 확인)
#
# [SECTION 7] 주문 승인 -> 배송 생성 + 재고 차감
#   Step 40. 주문 승인 -> Kafka -> 배송 생성 + 재고 차감
#   Step 41. 배송 목록 조회 (배송 생성 확인)
#   Step 42. 배송 상세 조회
#   Step 43. 재고 조회 (차감 확인)
#   Step 44. 주문 상세 조회 (배송 생성 완료 후 상태 검증)
#   Step 45. 알림 조회 (배송 생성 알림 확인)
#
# [SECTION 8] 배송 진행 (상태 변경)
#   Step 46. 허브 배송 시작 (start)
#   Step 47. 허브 도착 (arrive-hub)
#   Step 48. 허브 입고 (receive-hub)
#   Step 49. 업체 배송 시작 (start-company)
#   Step 50. 배송 완료 (complete)
#   Step 51. 배송 상세 조회 (최종 상태 검증)
#
# [SECTION 9] 최종 검증
#   Step 52. 주문 상세 조회 (배송 완료 후)
#   Step 53. 주문 목록 조회
#   Step 54. 재고 최종 조회
#   Step 55. 알림 조회 (배송 완료 알림 확인)
#
# ================================================================
###


# ================================================================
# [SECTION 1] 마스터 관리자 설정
# ================================================================

### Step 1. [마스터] 회원가입
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "{{masterUsername}}",
  "password": {
    "password": "{{masterPassword}}",
    "confirmPassword": "{{masterPassword}}"
  },
  "firstName": "마스터",
  "lastName": "관리자",
  "phone": "010-1111-9002",
  "email": "master-int2@test.com",
  "slackId": "U0ADEL196UT",
  "userRole": "MASTER",
  "hubId": "00000000-0000-0000-0000-000000000000"
}

> {%
  if (response.status !== 201) { client.log("FAIL: 마스터 회원가입 실패"); client.assert(false); }
  client.global.set("masterUserId", response.body.data.userId);
  client.log("[Step 1] masterUserId = " + client.global.get("masterUserId"));
%}

### Step 2. [마스터] 로그인 (MASTER는 회원가입 시 자동 승인)
POST {{gatewayUrl}}/api/v1/users/login
Content-Type: application/json

{
  "username": "{{masterUsername}}",
  "password": "{{masterPassword}}"
}

> {%
  if (response.status !== 200) { client.log("FAIL: 마스터 로그인 실패"); client.assert(false); }
  client.global.set("masterToken", response.body.data.accessToken);
  client.log("[Step 2] masterToken 저장 완료");
%}


# ================================================================
# [SECTION 2] 허브 인프라 구축
# ================================================================

### Step 4. 허브 생성 - 서울
