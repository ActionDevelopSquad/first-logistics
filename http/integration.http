### Step 19. 허브 관리자 회원가입 (서울 허브)
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "{{hubManagerUsername}}",
  "password": {
    "password": "{{hubManagerPassword}}",
    "confirmPassword": "{{hubManagerPassword}}"
  },
  "firstName": "허브",
  "lastName": "관리자",
  "phone": "010-2222-9002",
  "email": "hubmgr-int2@test.com",
  "slackId": "U0ADEL196UT",
  "userRole": "HUB_MANAGER",
  "hubId": "{{seoulHubId}}"
}

> {%
  if (response.status !== 201) { client.log("FAIL: 허브 관리자 회원가입 실패"); client.assert(false); }
  client.global.set("hubManagerUserId", response.body.data.userId);
  client.log("[Step 19] hubManagerUserId = " + client.global.get("hubManagerUserId"));
%}

### Step 20. 허브 관리자 승인 (Kafka → hub-service 허브 관리자 자동 생성)
PATCH {{gatewayUrl}}/api/v1/users/{{hubManagerUserId}}/status
Content-Type: application/json
Authorization: Bearer {{masterToken}}
X-User-Id: {{masterUserId}}

{
  "status": "APPROVED"
}

> {%
  function wait(sec) { let s = Date.now(); while (Date.now() - s < sec * 1000) {} }
  if (response.status !== 200) {
    client.log("FAIL: 허브 관리자 승인 실패 - 15초 블로킹");
    wait(15);
  } else {
    client.log("[Step 20] 허브 관리자 승인 완료");
    wait(1.5);
  }
%}

