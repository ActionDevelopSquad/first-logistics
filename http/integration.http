###
# ================================================================
# 일등 물류 통합 테스트 - 전체 성공 사이클
# ================================================================
# 기본 URL : {{gatewayUrl}} (API Gateway)
# 실행 방법: Step 순서대로 클릭 (IntelliJ HTTP Client)
# 환경 선택: local — 우측 드롭다운에서 선택
#
# ----------------------------------------------------------------
# 전체 흐름 요약
# ----------------------------------------------------------------
#
# [SECTION 1] 마스터 관리자 설정
#   Step  1. 마스터 회원가입 (MASTER는 자동 승인)
#   Step  2. 마스터 로그인
#
# [SECTION 2] 허브 인프라 구축
#   Step  4. 허브 생성 - 서울
#   Step  5. 허브 생성 - 경기 북부
#   Step  6. 허브 생성 - 부산
#   Step  7. 허브 목록 조회 (검증)
#   Step  8. 허브 간 이동정보 - 서울 -> 경기 북부
#   Step  9. 허브 간 이동정보 - 경기 북부 -> 부산
#   Step 10. 허브 간 이동정보 - 서울 -> 부산 (직통)
#
# [SECTION 3] 사용자 등록 (허브 관리자, 업체 담당자)
#   Step 11. 허브 관리자 회원가입 (서울 허브)
#   Step 12. 허브 관리자 승인
#   Step 13. 허브 관리자 로그인
#   Step 14. 업체 담당자 회원가입 (공급업체)
#   Step 15. 업체 담당자 회원가입 (수령업체)
#   Step 16. 업체 담당자 승인 (공급)
#   Step 17. 업체 담당자 승인 (수령)
#
# [SECTION 4] 업체 + 상품 등록
#   Step 18. 공급업체 생성 (서울 허브)
#   Step 19. 수령업체 생성 (부산 허브)
#   Step 20. 업체 목록 조회 (검증)
#   Step 21. 상품 생성 (공급업체)
#   Step 22. 상품 조회 (검증)
#   Step 23. 재고 조회 (검증)
#
# [SECTION 5] 배송 담당자 등록 (Kafka 자동 생성)
#   Step 24. 허브 배송담당자 회원가입
#   Step 25. 업체 배송담당자 회원가입
#   Step 26. 허브 배송담당자 승인 -> Kafka -> 배송담당자 자동 생성
#   Step 27. 업체 배송담당자 승인 -> Kafka -> 배송담당자 자동 생성
#   Step 28. 배송담당자 목록 조회 (검증)
#
# [SECTION 6] 주문 생성 -> 재고 예약 -> 주문 완료
#   Step 29. 주문 생성 -> Kafka -> 재고 예약 요청
#   Step 30. 주문 상세 조회 (재고 예약 완료 후 상태 검증)
#   Step 31. 재고 조회 (예약 반영 확인)
#
# [SECTION 7] 주문 승인 -> 배송 생성 + 재고 차감
#   Step 32. 주문 승인 -> Kafka -> 배송 생성 + 재고 차감
#   Step 33. 배송 목록 조회 (배송 생성 확인)
#   Step 34. 배송 상세 조회
#   Step 35. 재고 조회 (차감 확인)
#   Step 36. 주문 상세 조회 (배송 생성 완료 후 상태 검증)
#
# [SECTION 8] 배송 진행 (상태 변경)
#   Step 37. 허브 배송 시작 (start)
#   Step 38. 허브 도착 (arrive-hub)
#   Step 39. 허브 입고 (receive-hub)
#   Step 40. 업체 배송 시작 (start-company)
#   Step 41. 배송 완료 (complete)
#   Step 42. 배송 상세 조회 (최종 상태 검증)
#
# [SECTION 9] 최종 검증
#   Step 43. 주문 상세 조회 (배송 완료 후)
#   Step 44. 주문 목록 조회
#   Step 45. 재고 최종 조회
#
# ----------------------------------------------------------------
# 자동 저장 변수 목록
#   masterUserId / masterToken
#   seoulHubId / gyeonggiHubId / busanHubId
#   hubManagerUserId / hubManagerToken
#   companyManagerUserId / receiverManagerUserId
#   supplierCompanyId / receiverCompanyId
#   hubDeliveryManagerUserId / companyDeliveryManagerUserId
#   hubDeliveryManagerToken / companyDeliveryManagerToken
#   productId
#   orderId / deliveryId
# ================================================================
###


###
# ================================================================
# [SECTION 1] 마스터 관리자 설정
# ================================================================

### Step 1. [마스터] 회원가입
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "username": "{{masterUsername}}",
  "password": {
    "password": "{{masterPassword}}",
    "confirmPassword": "{{masterPassword}}"
  },
  "firstName": "마스터",
  "lastName": "관리자",
  "phone": "010-1111-9001",
  "email": "master-int@test.com",
  "slackId": "U_MASTER_INT",
  "userRole": "MASTER",
  "hubId": "00000000-0000-0000-0000-000000000000"
}

> {%
  if (response.status !== 201) { client.log("FAIL: 마스터 회원가입 실패"); client.assert(false); }
  client.global.set("masterUserId", response.body.data.userId);
  client.log("[Step 1] masterUserId = " + client.global.get("masterUserId"));
%}

### Step 2. [마스터] 로그인 (MASTER는 회원가입 시 자동 승인)
POST {{gatewayUrl}}/api/v1/users/login
Content-Type: application/json

{
  "username": "{{masterUsername}}",
  "password": "{{masterPassword}}"
}

> {%
  if (response.status !== 200) { client.log("FAIL: 마스터 로그인 실패"); client.assert(false); }
  client.global.set("masterToken", response.body.data.accessToken);
  client.log("[Step 2] masterToken 저장 완료");
%}


###
# ================================================================
# [SECTION 2] 허브 인프라 구축
# ================================================================


