### Step 29. 주문 생성 -> Kafka -> 재고 예약 요청
POST {{gatewayUrl}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{masterToken}}

{
  "supplierCompanyId": "{{supplierCompanyId}}",
  "supplierManagerId": "{{companyManagerUserId}}",
  "receiverCompanyId": "{{receiverCompanyId}}",
  "receiverManagerId": "{{receiverManagerUserId}}",
  "roadAddress": "부산 해운대구 해운대로 456",
  "detailAddress": "1층",
  "dueDate": "2026-04-15T18:00:00",
  "requestMemo": "통합테스트 주문",
  "items": [
    {
      "productId": "{{productId}}",
      "productName": "마른오징어 가공품",
      "unitPrice": 15000,
      "quantity": 10
    }
  ]
}

> {%
  if (response.status !== 201) { client.log("FAIL: 주문 생성 실패"); client.assert(false); }
  client.global.set("orderId", response.body.data.orderId);
  client.log("[Step 29] orderId = " + client.global.get("orderId"));
  // Kafka: order.created -> product-service 재고 예약 -> stock.reserved -> order-service 주문 완료
  var start = Date.now(); while (Date.now() - start < 5000) {}
%}

